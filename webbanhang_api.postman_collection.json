	"item": [
		{
			"name": "API Sản phẩm",
			"item": [
				{
					"name": "Lấy tất cả sản phẩm",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Mã trạng thái phản hồi phải là 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Dữ liệu trả về phải là mảng JSON hợp lệ\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.be.an(\"array\");",
									"});",
									"",
									"pm.test(\"Thời gian phản hồi phải nhỏ hơn 300ms\", function () {",
									"    pm.expect(pm.response.responseTime).to.be.below(300);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/product",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"product"
							]
						}
					},
					"response": []
				},
				{
					"name": "Tạo sản phẩm mới",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Mã trạng thái phản hồi phải là 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Xác nhận thông báo tạo thành công hợp lệ\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.message).to.eql(\"Product created successfully\");",
									"});",
									"",
									"// Tự động tìm ID sản phẩm vừa tạo mới và lưu vào biến bộ sưu tập",
									"const baseUrl = pm.collectionVariables.get(\"baseUrl\");",
									"pm.sendRequest(`${baseUrl}/api/product`, function (err, response) {",
									"    if (err) {",
									"        console.log(\"Lỗi khi tìm ID sản phẩm mới:\", err);",
									"    } else {",
									"        const products = response.json();",
									"        // Tìm sản phẩm có tên trùng khớp vừa tạo",
									"        const targetProduct = products.find(p => p.name === \"Laptop ASUS Zenbook Pro\");",
									"        if (targetProduct) {",
									"            pm.collectionVariables.set(\"createdProductId\", targetProduct.id);",
									"            console.log(\"Đã lưu ID sản phẩm mới tạo vào biến createdProductId: \" + targetProduct.id);",
									"        } else {",
									"            console.log(\"Không tìm thấy sản phẩm vừa tạo trong danh sách.\");",
									"        }",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Laptop ASUS Zenbook Pro\",\n    \"description\": \"Core Ultra 9, OLED Screen, 32GB RAM\",\n    \"price\": 45000000,\n    \"category_id\": 1\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/product",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"product"
							]
						}
					},
					"response": []
				},
				{
					"name": "Lấy sản phẩm theo ID",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Mã trạng thái phản hồi phải là 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Xác minh cấu trúc sản phẩm và ID động\", function () {",
									"    var jsonData = pm.response.json();",
									"    var expectedId = pm.collectionVariables.get(\"createdProductId\");",
									"    pm.expect(jsonData.id).to.eql(parseInt(expectedId));",
									"    pm.expect(jsonData.name).to.eql(\"Laptop ASUS Zenbook Pro\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/product/{{createdProductId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"product",
								"{{createdProductId}}"
							]
						}
					},
					"response": []
				},
				{
					"name": "Cập nhật sản phẩm",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Mã trạng thái phản hồi phải là 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Xác nhận thông báo cập nhật thành công\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.message).to.eql(\"Product updated successfully\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Laptop ASUS Zenbook Pro Updated\",\n    \"description\": \"Core Ultra 9, OLED Screen, 32GB RAM, Windows 11 Pro\",\n    \"price\": 43900000,\n    \"category_id\": 1\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/product/{{createdProductId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
