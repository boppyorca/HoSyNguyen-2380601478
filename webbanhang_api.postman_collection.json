		{
			"name": "API Đơn hàng",
			"item": [
				{
					"name": "Lấy tất cả đơn hàng",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Mã trạng thái phản hồi phải là 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Tải danh sách đơn hàng thành công\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.be.an(\"array\");",
									"    if (jsonData.length > 0) {",
									"        // Lấy ID đơn hàng mới nhất và lưu vào biến",
									"        pm.collectionVariables.set(\"createdOrderId\", jsonData[0].id);",
									"        console.log(\"Đã lưu ID đơn hàng mới nhất vào biến: \" + jsonData[0].id);",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/order",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"order"
							]
						}
					},
					"response": []
				},
				{
					"name": "Lấy chi tiết đơn hàng theo ID",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Mã trạng thái phản hồi phải là 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Xác minh cấu trúc phản hồi chi tiết đơn hàng\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property(\"order\");",
									"    pm.expect(jsonData).to.have.property(\"details\");",
									"    pm.expect(jsonData.order.id).to.eql(parseInt(pm.collectionVariables.get(\"createdOrderId\")));",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/order/{{createdOrderId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"order",
								"{{createdOrderId}}"
							]
						}
					},
					"response": []
				},
				{
					"name": "Cập nhật trạng thái đơn hàng",
					"event": [
