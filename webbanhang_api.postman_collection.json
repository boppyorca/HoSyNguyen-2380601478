							]
						}
					},
					"response": []
				},
				{
					"name": "Xóa sản phẩm",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Mã trạng thái phản hồi phải là 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Xác nhận thông báo xóa thành công\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.message).to.eql(\"Product deleted successfully\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/product/{{createdProductId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
