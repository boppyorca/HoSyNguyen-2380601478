				{
					"name": "Xác minh chi tiết sản phẩm sau cập nhật",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Mã trạng thái phản hồi phải là 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Xác minh các trường thông tin sau cập nhật khớp dữ liệu\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.name).to.eql(\"Laptop ASUS Zenbook Pro Updated\");",
									"    pm.expect(parseFloat(jsonData.price)).to.eql(43900000);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
